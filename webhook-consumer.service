[Unit]
Description=AI Webhook SQS Consumer
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/shipment-webhook
EnvironmentFile=/home/ubuntu/shipment-webhook/.env
ExecStart=/home/ubuntu/venv/bin/python manage.py consume_webhooks
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
