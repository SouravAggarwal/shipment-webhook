[Unit]
Description=AI Webhook API Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/shipment-webhook
EnvironmentFile=/home/ubuntu/shipment-webhook/.env
ExecStart=/home/ubuntu/venv/bin/python manage.py runserver 0.0.0.0:8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
